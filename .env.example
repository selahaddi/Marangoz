# Marangoz CAD/CAM Çevre Değişkenleri Şablonu
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin.

# Google Gemini API Anahtarı (Doğal dil ve görsel ayrıştırma için)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sunucu Ayarları
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
